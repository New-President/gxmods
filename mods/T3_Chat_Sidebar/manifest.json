{
  "manifest_version": 3,
  "name": "T3 Chat",
  "short_name": "T3 Chat",
  "version": "1.0.0",
  "description": "Opera GX sidebar panel for T3 Chat (https://t3.chat/).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "sidebar_action": {
    "default_panel": "sidepanel/panel.html",
    "default_title": "T3 Chat",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "T3 Chat",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "cookies"
  ],
  "host_permissions": [
    "https://t3.chat/*",
    "https://*.t3.chat/*",
    "https://*.convex.cloud/*",
    "https://*.convex.site/*",
    "https://*.clerk.accounts.dev/*",
    "https://accounts.google.com/*",
    "https://*.google.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "t3_framing_rules",
        "enabled": true,
        "path": "rules/framing-rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://t3.chat/*",
        "https://*.t3.chat/*"
      ],
      "js": [
        "content/t3-session-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://t3.chat/*",
        "https://*.t3.chat/*"
      ],
      "js": [
        "content/t3-cookie-sync.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
