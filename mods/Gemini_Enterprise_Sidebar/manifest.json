{
  "manifest_version": 3,
  "name": "Gemini Enterprise",
  "short_name": "Gemini Enterprise",
  "version": "1.3.0",
  "description": "Opera GX sidebar panel for Google Cloud Gemini Enterprise (Vertex AI Search).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "sidebar_action": {
    "default_panel": "sidepanel/panel.html",
    "default_title": "Gemini Enterprise",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "Gemini Enterprise",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "cookies"
  ],
  "host_permissions": [
    "https://vertexaisearch.cloud.google.com/*",
    "https://*.cloud.google.com/*",
    "https://accounts.google.com/*",
    "https://*.google.com/*",
    "https://*.googleapis.com/*",
    "https://*.gstatic.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "gemini_framing_rules",
        "enabled": true,
        "path": "rules/framing-rules.json"
      }
    ]
  }
}
